{
  "name": "fieldnotes-knowledge-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:generate && cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "content:generate": "node scripts/generate-content.mjs",
    "content:verify": "node scripts/verify-content.mjs",
    "references:verify": "node scripts/verify-reference-audit.mjs",
    "references:check-live": "node scripts/check-external-references.mjs",
    "artifact:verify": "node scripts/verify-built-artifact.mjs",
    "check": "npm run content:generate && cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "npm run content:generate && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && npm run content:verify && npm run references:verify && npm run artifact:verify",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test:unit": "npm run content:generate && node --test tests/unit/*.test.mjs",
    "test:e2e": "cross-env PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
    "test": "npm run test:unit && npm run check && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "astro": "7.4.13",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.5.438",
    "simple-icons": "16.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "cross-env": "10.1.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}

