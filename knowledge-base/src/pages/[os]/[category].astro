---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideDirectory from '../../components/GuideDirectory.astro';
import {
  categoryLabels,
  guideCategories,
  guidesForPlacement,
  operatingSystems,
  osLabels,
  type GuideCategory,
  type OperatingSystem,
} from '../../lib/guide-data';
import { withBase } from '../../lib/routes';

export function getStaticPaths() {
  return operatingSystems.flatMap((os) => guideCategories.map((category) => ({ params: { os, category } })));
}

const os = Astro.params.os as OperatingSystem;
const category = Astro.params.category as GuideCategory;
const collectionGuides = guidesForPlacement(os, category);
---

<BaseLayout title={`${osLabels[os]} ${categoryLabels[category]}`} activePath={`/${os}/`} wide>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={withBase('/')}>Overview</a><span aria-hidden="true">/</span>
    <a href={withBase(`/${os}/`)}>{osLabels[os]}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{categoryLabels[category]}</span>
  </nav>
  <header class="page-header">
    <span class="eyebrow">{osLabels[os]} collection</span>
    <h1>{categoryLabels[category]}</h1>
    <p class="lede">Source-backed {categoryLabels[category].toLocaleLowerCase()} for {osLabels[os]}, including review and compatibility status.</p>
  </header>
  {collectionGuides.length > 0 ? (
    <GuideDirectory guides={collectionGuides} />
  ) : (
    <div class="empty-state">
      <h2>No source-backed guides yet</h2>
      <p>The source audit found no genuine {osLabels[os]} {categoryLabels[category].toLocaleLowerCase()}; FIELDNOTES will not invent one to fill the category.</p>
    </div>
  )}
</BaseLayout>

