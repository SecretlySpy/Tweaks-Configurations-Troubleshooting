---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideDirectory from '../components/GuideDirectory.astro';
import OsIcon from '../components/OsIcon.astro';
import {
  guideData,
  guides,
  guidesForOs,
  osLabels,
  operatingSystems,
} from '../lib/guide-data';
import { withBase } from '../lib/routes';

const featuredGuides = guides
  .filter((guide) => guide.publicStatus === 'published')
  .slice(0, 6);
---

<BaseLayout activePath="/" wide>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <span class="eyebrow">Traceable technical field guides</span>
      <h1 id="hero-title">Solve the system.<span>Keep the source.</span></h1>
      <p class="lede">
        Search operating-system setup, tuning, and troubleshooting notes without losing the commands,
        warnings, provenance, or recovery context in the original files.
      </p>
      <form class="hero-search" action={withBase('/all-guides/')} role="search">
        <label class="sr-only" for="hero-search">Search FIELDNOTES</label>
        <input id="hero-search" name="q" type="search" placeholder="Try “Docker Compose”, “registry”, or “ADB”…" />
        <button type="submit">Search guides</button>
      </form>
      <div class="hero-meta" aria-label="Knowledge base summary">
        <span>{guideData.coverage.guideCount} canonical guides</span>
        <span>{guideData.coverage.primaryCoveragePercent}% primary sources mapped</span>
        <span>No automatic command execution</span>
      </div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="collections-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Browse by platform</span>
        <h2 id="collections-title">Operating-system collections</h2>
        <p>Each collection keeps tweaks, application setup, and troubleshooting paths predictable.</p>
      </div>
      <a class="text-link" href={withBase('/all-guides/')}>Browse all guides</a>
    </div>
    <div class="os-grid">
      {operatingSystems.map((os) => (
        <a class="os-card" href={withBase(`/${os}/`)}>
          <span class="os-card-icon"><OsIcon os={os} size={32} /></span>
          <h3>{osLabels[os]}</h3>
          <p>Open the {osLabels[os]} collection and filter by the task you need to finish.</p>
          <span class="card-footer">
            <span>{guidesForOs(os).length} mapped guides</span>
            <span aria-hidden="true">Explore</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Start here</span>
        <h2 id="featured-title">Featured fieldnotes</h2>
        <p>Representative setup, tuning, and recovery material from the current migration baseline.</p>
      </div>
    </div>
    <GuideDirectory guides={featuredGuides} showFilters={false} />
  </section>

  <section class="section-block" aria-labelledby="integrity-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Migration integrity</span>
        <h2 id="integrity-title">Every source has a disposition</h2>
        <p>Primary guides are mapped; additional app/configuration exports stay in review until their public-safety gates pass.</p>
      </div>
    </div>
    <div class="stats-grid">
      <div class="stat-card"><strong>{guideData.coverage.discoveredSourceCount}</strong><span>inventoried source files</span></div>
      <div class="stat-card"><strong>{guideData.coverage.mappedPrimarySourceCount}</strong><span>mapped primary sources</span></div>
      <div class="stat-card"><strong>{guideData.coverage.secondaryReviewSourceCount}</strong><span>secondary sources in review</span></div>
      <div class="stat-card"><strong>{guideData.coverage.blockedGuideCount}</strong><span>operational migrations blocked</span></div>
    </div>
  </section>
</BaseLayout>

