---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideDirectory from '../components/GuideDirectory.astro';
import OsIcon from '../components/OsIcon.astro';
import {
  guideData,
  guides,
  osLabels,
  operatingSystems,
} from '../lib/guide-data';
import { withBase } from '../lib/routes';

const featuredGuides = guides
  .filter((guide) => guide.publicStatus === 'published')
  .slice(0, 6);
---

<BaseLayout activePath="/" wide>
  <section class="home-intro" aria-labelledby="hero-title">
    <div class="home-intro-copy">
      <span class="home-kicker home-kicker--desktop">Library&nbsp; / &nbsp;Overview</span>
      <span class="home-kicker home-kicker--tablet">Home&nbsp; / &nbsp;Overview</span>
      <span class="home-kicker home-kicker--mobile">Technical library</span>
      <h1 id="hero-title">
        <span class="home-title-wide">Your technical library,<br />{' '}made easier to navigate.</span>
        <span class="home-title-mobile">A clearer way to<br />{' '}find the fix.</span>
      </h1>
    </div>

    <form class="home-search" action={withBase('/all-guides/')} role="search">
      <label class="sr-only" for="home-search">Search Technical Resources</label>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none">
        <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.7"></circle>
        <path d="m15.2 15.2 4.3 4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
      </svg>
      <input id="home-search" name="q" type="search" placeholder="Search docs and commands…" autocomplete="off" />
      <button class="sr-only" type="submit">Search</button>
    </form>

    <aside class="discovery-callout" aria-labelledby="discovery-title">
      <h2 id="discovery-title">Start with a platform or search.</h2>
      <a class="discovery-link" href={withBase('/all-guides/')}>Browse guides <span aria-hidden="true">›</span></a>
    </aside>
  </section>

  <section class="home-platforms" aria-labelledby="collections-title">
    <div class="home-section-heading">
      <h2 id="collections-title">
        <span class="home-os-heading-wide">Choose your operating system</span>
        <span class="home-os-heading-mobile">Choose your OS</span>
      </h2>
    </div>
    <div class="os-grid home-os-grid">
      {operatingSystems.map((os) => (
        <a class={`os-card os-card--${os}`} href={withBase(`/${os}/`)}>
          <span class="os-card-icon"><OsIcon os={os} size={36} /></span>
          <span class="os-card-copy">
            <h3>{osLabels[os]}</h3>
            <p>
              {os === 'windows' && 'Performance and recovery'}
              {os === 'linux' && 'System tuning and setup'}
              {os === 'android' && 'ADB and Termux'}
            </p>
          </span>
          <span class="os-card-action">
            <span class="os-card-categories">Tweaks&nbsp; · &nbsp;App setup&nbsp; · &nbsp;Troubleshooting</span>
            <span class="os-card-explore"><span>Explore&nbsp;</span><span aria-hidden="true">›</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block home-secondary-content" aria-labelledby="featured-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Start here</span>
        <h2 id="featured-title">Featured technical resources</h2>
        <p>Representative setup, tuning, and recovery material from the current migration baseline.</p>
      </div>
    </div>
    <GuideDirectory guides={featuredGuides} showFilters={false} />
  </section>

  <section class="section-block home-secondary-content" aria-labelledby="integrity-title">
    <div class="section-heading">
      <div>
        <span class="eyebrow">Migration integrity</span>
        <h2 id="integrity-title">Every source has a disposition</h2>
        <p>Primary guides are mapped; additional app/configuration exports stay in review until their public-safety gates pass.</p>
      </div>
    </div>
    <div class="stats-grid">
      <div class="stat-card"><strong>{guideData.coverage.discoveredSourceCount}</strong><span>inventoried source files</span></div>
      <div class="stat-card"><strong>{guideData.coverage.mappedPrimarySourceCount}</strong><span>mapped primary sources</span></div>
      <div class="stat-card"><strong>{guideData.coverage.secondaryReviewSourceCount}</strong><span>secondary sources in review</span></div>
      <div class="stat-card"><strong>{guideData.coverage.blockedGuideCount}</strong><span>operational migrations blocked</span></div>
    </div>
  </section>
</BaseLayout>

